+export const CANONICAL_OPERATIONAL_PROFILES = ["vendeur", "polyvalent", "teller"] as const;
+export type CanonicalOperationalProfile = (typeof CANONICAL_OPERATIONAL_PROFILES)[number];
+
+export const RETIRED_OPERATIONAL_PROFILES = new Set<string>(["head_teller", "manager", "owner"]);
+export const COMMERCIAL_EMPLOYEE_ROLES = new Set<string>(["EMPLOYEE"]);
+export const TELLER_ROLES = new Set<string>([
+  "JUNIOR_TELLER",
+  "SENIOR_TELLER",
+  "HEAD_TELLER",
+  "MASTER_HEAD_TELLER",
+  "TELLER"
+]);
+export const EXECUTIVE_RBAC_ROLES = new Set<string>(["OWNER", "MANAGER", "ADMIN", "SUPER_ADMIN"]);
+export const INTERNAL_TRANSFER_APPROVER_ROLES = new Set<string>([
+  "SUPER_ADMIN",
+  "OWNER",
+  "ADMIN",
+  "MANAGER",
+  "HEAD_TELLER"
+]);
+export const TILL_SUPERVISOR_ROLES = new Set<string>([
+  "HEAD_TELLER",
+  "MASTER_HEAD_TELLER",
+  "MANAGER",
+  "OWNER",
+  "ADMIN",
+  "SUPER_ADMIN"
+]);
+
+// Enforces:
+// - normalizeOperationalProfile(..., { role, allowLegacyBarberAlias }): maps legacy "barber" -> "vendeur" ONLY for EMPLOYEE when allowed; rejects retired pseudo-profiles and missing/malformed inputs.
+// - extractRawOperationalProfileFromRecord(record): detects dual-field conflict between operational_profile and operationalProfile.
+// - validateRoleOperationalProfileCompatibility(role, profile, opts): rejects all 9 forbidden pairs, oversight/retired profiles, and missing operational profiles.
+// - evaluateOperationalProfileAccess(role, profile, capability, opts): EMPLOYEE+vendeur (sales only), EMPLOYEE+polyvalent (sales+services, NO cash), TELLER+teller (cash only).
+// - canApproveInternalTransferRole(role): explicitly EXCLUDES MASTER_HEAD_TELLER.
+// - canSuperviseTillLifecycleRole(role): INCLUDES MASTER_HEAD_TELLER & HEAD_TELLER alongside EXECUTIVE_RBAC_ROLES.

