      allow delete: if isSuperAdmin();
    }

    match /business_archives/{id} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // === NOTIFICATIONS ===
    match /notifications/{notificationId} {
      function isTargetedNotification() {
        return (
          (resource.data.get('targetUserId', '') != '' && resource.data.get('targetUserId', '') == request.auth.uid) ||
          (resource.data.get('target_user_id', '') != '' && resource.data.get('target_user_id', '') == request.auth.uid) ||
          (resource.data.get('targetRoles', []) is list && getUserRole() in resource.data.get('targetRoles', [])) ||
          (resource.data.get('target_roles', []) is list && getUserRole() in resource.data.get('target_roles', [])) ||
          (resource.data.get('targetRoles', []) is list && isBusinessOwner(getBusinessId(resource.data)) && 'OWNER' in resource.data.get('targetRoles', [])) ||
          (resource.data.get('target_roles', []) is list && isBusinessOwner(getBusinessId(resource.data)) && 'OWNER' in resource.data.get('target_roles', []))
        );
      }

      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (getBusinessId(resource.data) == getUserBusinessId() || isBusinessOwner(getBusinessId(resource.data))) &&
          isTargetedNotification()
        )
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isBusinessOwner(getBusinessId(request.resource.data)) ||
        getUserRole() in ['ADMIN', 'OWNER', 'MANAGER'] ||
        (getBusinessId(request.resource.data) == getUserBusinessId() && getBusinessId(request.resource.data) != '')
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isBusinessOwner(getBusinessId(resource.data)) ||
        getUserRole() in ['ADMIN', 'OWNER', 'MANAGER'] ||
        (
          (getBusinessId(resource.data) == getUserBusinessId() || isBusinessOwner(getBusinessId(resource.data))) &&
          isTargetedNotification() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt', 'readAt', 'updated_at', 'read_at'])
        )
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        isBusinessOwner(getBusinessId(resource.data)) ||
        getUserRole() in ['ADMIN', 'OWNER']
      );
    }

    // === CRM, PROSPECTING & SALES INVOICING ===
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidLeadStatus(request.resource.data.get('status', 'LEAD'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidLeadStatus(request.resource.data.get('status', 'LEAD'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN', 'MANAGER'])
      );
    }

    match /proformas/{proformaId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          hasNoObsoleteInvoiceFields(request.resource.data) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          hasNoObsoleteInvoiceFields(request.resource.data) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoice_templates/{templateId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(request.resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }
  }
}


