rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Core Security & Identity Helpers ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return (isAuthenticated() && request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null) ? request.auth.token.email : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (getAuthEmail() != '' && getAuthEmail().lower() == 'tekpounou@gmail.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'chiloomoreservice@gmail.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'admin@finops.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'superadmin@finops.com') ||
        (request.auth.token != null && (
          ('is_super_admin' in request.auth.token && request.auth.token.is_super_admin == true) || 
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN')
        ))
      );
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getMyProfile() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function getUserBusinessId() {
      return (request.auth.token != null && 'businessId' in request.auth.token && request.auth.token.businessId != '' && request.auth.token.businessId != null)
        ? request.auth.token.businessId
        : ((request.auth.token != null && 'business_id' in request.auth.token && request.auth.token.business_id != '' && request.auth.token.business_id != null)
            ? request.auth.token.business_id
            : ((hasUserData() && getMyProfile().get('businessId', '') != '' && getMyProfile().get('businessId', '') != null) 
              ? getMyProfile().get('businessId', '') 
              : ((hasUserData() && getMyProfile().get('business_id', '') != '' && getMyProfile().get('business_id', '') != null)
                  ? getMyProfile().get('business_id', '')
                  : 'none')));
    }

    function getUserRole() {
      return (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role != '' && request.auth.token.role != null)
        ? request.auth.token.role
        : (hasUserData() ? (getMyProfile().get('role', 'none') == 'SUPER_ADMIN' ? 'none' : getMyProfile().get('role', 'none')) : 'none');
    }

    function getBusinessId(data) {
      return data == null ? 'none' : (
        data.get('businessId', '') != '' ? data.get('businessId', '') :
        (data.get('business_id', '') != '' ? data.get('business_id', '') :
        (data.get('tenantId', '') != '' ? data.get('tenantId', '') :
        (data.get('tenant_id', '') != '' ? data.get('tenant_id', '') : 'none')))
      );
    }

    function isBusinessOwner(bizId) {
      return isAuthenticated() && (
        bizId == 'biz_' + request.auth.uid ||
        (request.resource != null && request.resource.data != null && (
          request.resource.data.get('ownerId', '') == request.auth.uid ||
          request.resource.data.get('owner_id', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        )) ||
        (bizId != 'none' && bizId != '' && exists(/databases/$(database)/documents/businesses/$(bizId)) && (
          get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_id', '') == request.auth.uid
        ))
      );
    }

    function isTenantScoped(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (bizId != 'none' && bizId != '' && getUserBusinessId() != 'none' && getUserBusinessId() == bizId) ||
        (bizId != 'none' && bizId != '' && bizId == 'biz_' + request.auth.uid)
      );
    }

    function isTenantAdminOrManager(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (bizId != 'none' && bizId != '' && getUserBusinessId() != 'none' && getUserBusinessId() == bizId)
      );
    }

    function isAuthoritativeSecurityAction(action) {
      return action in [
        'USER_ROLE_CHANGED',
        'BUSINESS_APPROVED',
        'BUSINESS_SUSPENDED',
        'BUSINESS_ACTIVATED',
        'SUBSCRIPTION_CHANGED',
        'PERMISSION_CHANGED',
        'SUPER_ADMIN_ACTION',
        'FORENSIC_ACTION',
        'SECURITY_POLICY_CHANGED',
        'PLATFORM_CONFIG_CHANGED',
        'ROLE_ESCALATION_BLOCKED'
      ];
    }

    function isAuthoritativeEvent(data) {
      return isAuthoritativeSecurityAction(data.get('action', '')) ||
             isAuthoritativeSecurityAction(data.get('eventType', '')) ||
             isAuthoritativeSecurityAction(data.get('event_type', '')) ||
             isAuthoritativeSecurityAction(data.get('type', ''));
    }

    function isNonSuperAdminClaim(data) {
      return data.get('actorRole', '') != 'SUPER_ADMIN' &&
             data.get('actor_role', '') != 'SUPER_ADMIN' &&
             data.get('role', '') != 'SUPER_ADMIN' &&
             data.get('userRole', '') != 'SUPER_ADMIN';
    }

    function isValidAmount(val) {
      return val is number && val >= 0;
    }

    function isValidInvoiceStatus(status) {
      return status in ['DRAFT', 'SENT', 'ISSUED', 'PAID', 'PARTIALLY_PAID', 'OVERDUE', 'CANCELLED'];
    }

    function isValidProformaStatus(status) {
      return status in ['DRAFT', 'SENT', 'ACCEPTED', 'EXPIRED', 'CONVERTED_TO_INVOICE', 'REJECTED'];
    }

    function isValidLeadStatus(status) {
      return status in ['LEAD', 'PROSPECT', 'CLIENT', 'LOST'];
    }

    function userHasBusiness(uid) {
      return (
        (exists(/databases/$(database)/documents/users/$(uid)) && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('businessId', '') != '' && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('businessId', '') != null) ||
        (exists(/databases/$(database)/documents/users/$(uid)) && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('business_id', '') != '' && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('business_id', '') != null) ||
        exists(/databases/$(database)/documents/businesses/$('biz_' + uid))
      );
    }

    function canCreateAuditLog(data) {
      return isAuthenticated();
    }

    // === LOGGING & AUDIT TRAIL (Immutable Forensic Records) ===
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update: if false; // Audit logs must be strictly immutable
      allow delete: if false; // Forensic anti-tampering rule
    }

    match /forensic_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update: if false; 
      allow delete: if false;
    }

    match /enterprise_audit_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update: if false; 
      allow delete: if false;
    }

    match /security_audit_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update: if false; 
      allow delete: if false;
    }

    match /ai_cfo_audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /attendance_justifications/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === USER PROFILES ===
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role != 'SUPER_ADMIN') &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin != true) &&
          (!('is_super_admin' in request.resource.data) || request.resource.data.is_super_admin != true)
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (request.auth.uid == userId || isTenantAdminOrManager(getBusinessId(resource.data))) &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', 'EMPLOYEE')) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == resource.data.get('isSuperAdmin', false)) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.get('businessId', '')) &&
          (!('business_id' in request.resource.data) || request.resource.data.business_id == resource.data.get('business_id', ''))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === USER PREFERENCES ===
    match /user_preferences/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // === PENDING BUSINESS APPLICATIONS (Onboarding Super Admin Workflow) ===
    match /pending_businesses/{id} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        id == ('pbiz_' + request.auth.uid) ||
        (resource != null && (
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
      allow list: if isSuperAdmin();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.get('ownerUid', '') == request.auth.uid ||
        request.resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('owner_uid', '') == request.auth.uid) &&
          request.resource.data.get('status', 'PENDING') == 'PENDING'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS TENANTS ===
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(businessId) ||
        isBusinessOwner(businessId) ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          !userHasBusiness(request.auth.uid) &&
          request.resource.data.get('ownerId', '') == request.auth.uid &&
          request.resource.data.get('status', 'PENDING') in ['PENDING', 'PENDING_APPROVAL']
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (
            resource.data.get('ownerId', '') == request.auth.uid ||
            resource.data.get('owner_id', '') == request.auth.uid ||
            isBusinessOwner(businessId) ||
            (businessId == getUserBusinessId() && getUserRole() in ['ADMIN', 'OWNER'])
          ) &&
          (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.get('ownerId', '')) &&
          (!('owner_id' in request.resource.data) || request.resource.data.owner_id == resource.data.get('owner_id', '')) &&
          request.resource.data.get('status', resource.data.get('status', 'PENDING')) == resource.data.get('status', 'PENDING') &&
          request.resource.data.get('subscriptionPlan', resource.data.get('subscriptionPlan', 'STARTER')) == resource.data.get('subscriptionPlan', 'STARTER') &&
          request.resource.data.get('subscriptionStatus', resource.data.get('subscriptionStatus', 'ACTIVE')) == resource.data.get('subscriptionStatus', 'ACTIVE') &&
          request.resource.data.get('isApproved', resource.data.get('isApproved', false)) == resource.data.get('isApproved', false)
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === EVENT PROCESSING IDEMPOTENCY REGISTRY ===
    match /businesses/{businessId}/event_processing/{consumerId} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/{subcollection}/{document=**} {
      allow read, write: if isTenantScoped(businessId);
    }

    // === BUSINESS SETTINGS ===
    match /business_settings/{businessId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantAdminOrManager(businessId);
      allow delete: if isSuperAdmin();
    }

    // === BRANCHES ===
    match /branches/{branchId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === DEPARTMENTS ===
    match /departments/{deptId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === BUSINESS UNITS ===
    match /business_units/{unitId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === COST CENTERS ===
    match /cost_centers/{costCenterId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ORGANIZATIONS ===
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ROLES ===
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === EMPLOYEES ===
    match /employees/{empId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantScoped(getBusinessId(resource.data)) ||
        resource.data.get('firebase_uid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        (getAuthEmail() != '' && resource.data.get('email', '').lower() == getAuthEmail().lower()) ||
        (getAuthEmail() != '' && resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower())
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantScoped(getBusinessId(request.resource.data)) || 
        isTenantAdminOrManager(getBusinessId(request.resource.data))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantScoped(getBusinessId(resource.data)) ||
        isTenantAdminOrManager(getBusinessId(resource.data)) ||
        resource.data.get('firebase_uid', '') == request.auth.uid
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data))
      );
    }

    // === INVITATIONS ===
    match /invitations/{inviteId} {
      allow read: if true; // Needed to validate token before signup
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantScoped(getBusinessId(resource.data)) ||
        isTenantAdminOrManager(getBusinessId(resource.data)) ||
        (
          resource.data.get('email', '').lower() == getAuthEmail().lower() ||
          resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower() ||
          request.resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === EXCHANGE RATES ===
    match /exchange_rates/{rateId} {
      allow read: if true; // Public currency reference
      allow write: if isAuthenticated() && (isSuperAdmin() || getUserRole() in ['ADMIN', 'MANAGER', 'OWNER']);
    }

    // === TRANSACTIONS & GENERAL LEDGER ===
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /ledger_transactions/{txId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /financial_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /bank_reconciliations/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /analytics_processed_transactions/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === GL (Bulk Upload Storage) ===
    match /GL/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === EVENTS (Reliable Outbox & Orchestrator Events) ===
    match /events/{eventId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === WORKFLOW & APPROVAL ENGINE ===
    match /workflow_definitions/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(request.resource.data)) ||
        isTenantAdminOrManager(getBusinessId(request.resource.data)) ||
        getBusinessId(request.resource.data) == 'biz_' + request.auth.uid ||
        getBusinessId(request.resource.data) == getUserBusinessId()
      );
      allow delete: if isSuperAdmin();
    }

    match /approval_policies/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(request.resource.data)) ||
        isTenantAdminOrManager(getBusinessId(request.resource.data)) ||
        getBusinessId(request.resource.data) == 'biz_' + request.auth.uid ||
        getBusinessId(request.resource.data) == getUserBusinessId()
      );
      allow delete: if isSuperAdmin();
    }

    match /approval_instances/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(request.resource.data)) ||
        (resource != null && isTenantScoped(getBusinessId(resource.data)))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
    }

    match /active_approval_locks/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(request.resource.data)) ||
        (resource != null && isTenantScoped(getBusinessId(resource.data)))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
    }

    match /workflow_instances/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === INTEGRITY REPORTS ===
    match /integrity_reports/{reportId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === ANALYTICS SNAPSHOTS ===
    match /analytics_snapshots/{snapId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === BRANCH DEPARTMENT LINKS ===
    match /branch_department_links/{linkId} {
