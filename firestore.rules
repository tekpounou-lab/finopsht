    match /proformas/{proformaId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoice_templates/{templateId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(request.resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /sales_requests/{reqId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'name']) &&
                       request.resource.data.keys().hasOnly(['id', 'email', 'name', 'phone', 'companyName', 'message', 'createdAt', 'status']) &&
                       request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
                       request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
                       (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000));
      allow read, update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /analytics_anomalies/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /department_aliases/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /workforce_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === PHASE 7: WORKFORCE INTELLIGENCE, METRICS & BENCHMARKS ===
    match /workforce_productivity_benchmarks/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /labor_economics_metrics/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /shift_labor_efficiency/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /metric_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /financial_metrics/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payment_methods/{methodId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.scope == "GLOBAL" || 
        (resource.data.scope == "TENANT" && isTenantScoped(getBusinessId(resource.data)))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (request.resource.data.scope == "TENANT" && isTenantAdminOrManager(getBusinessId(request.resource.data)))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource.data.scope == "TENANT" && isTenantAdminOrManager(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
    }

    // === CATCH-ALL FALLBACK FOR ALL COLLECTIONS & SUBCOLLECTIONS ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


