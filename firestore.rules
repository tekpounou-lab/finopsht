rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Core Security & Identity Helpers ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return (isAuthenticated() && request.auth.token != null && 'email' in request.auth.token) ? request.auth.token.email : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (getAuthEmail() != '' && getAuthEmail().lower() == 'tekpounou@gmail.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'chiloomoreservice@gmail.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'admin@finops.com') ||
        (getAuthEmail() != '' && getAuthEmail().lower() == 'superadmin@finops.com') ||
        (request.auth.token != null && (
          ('is_super_admin' in request.auth.token && request.auth.token.is_super_admin == true) || 
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'SUPER_ADMIN')
      );
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getMyProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserBusinessId() {
      return (hasUserData() && getMyProfile().get('business_id', '') != '' && getMyProfile().get('business_id', '') != null) 
        ? getMyProfile().get('business_id', '') 
        : ((hasUserData() && getMyProfile().get('businessId', '') != '' && getMyProfile().get('businessId', '') != null)
            ? getMyProfile().get('businessId', '')
            : 'none');
    }

    function getUserRole() {
      return hasUserData() ? getMyProfile().get('role', 'none') : 'none';
    }

    function getBusinessId(data) {
      return data == null ? 'none' : (
        data.get('business_id', '') != '' ? data.get('business_id', '') :
        (data.get('businessId', '') != '' ? data.get('businessId', '') :
        (data.get('tenantId', '') != '' ? data.get('tenantId', '') :
        (data.get('tenant_id', '') != '' ? data.get('tenant_id', '') : 'none')))
      );
    }

    function isBusinessOwner(bizId) {
      return isAuthenticated() && (
        bizId == ('biz_' + request.auth.uid) ||
        (bizId != 'none' && exists(/databases/$(database)/documents/businesses/$(bizId)) && (
          get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_id', '') == request.auth.uid
        )) ||
        (bizId != 'none' && existsAfter(/databases/$(database)/documents/businesses/$(bizId)) && (
          getAfter(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == request.auth.uid ||
          getAfter(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_id', '') == request.auth.uid
        )) ||
        (request.resource != null && (
          request.resource.data.get('ownerId', '') == request.auth.uid ||
          request.resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
    }

    function isTenantScoped(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (bizId != 'none' && (bizId == getUserBusinessId() || isBusinessOwner(bizId)))
      );
    }

    function isTenantAdminOrManager(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(bizId) && (isBusinessOwner(bizId) || getUserRole() in ['ADMIN', 'MANAGER', 'OWNER', 'SUPER_ADMIN']))
      );
    }

    function isValidAmount(val) {
      return val is number && val >= 0;
    }

    function isValidInvoiceStatus(status) {
      return status in ['DRAFT', 'SENT', 'ISSUED', 'PAID', 'PARTIALLY_PAID', 'OVERDUE', 'CANCELLED'];
    }

    function isValidProformaStatus(status) {
      return status in ['DRAFT', 'SENT', 'ACCEPTED', 'EXPIRED', 'CONVERTED_TO_INVOICE', 'REJECTED'];
    }

    function isValidLeadStatus(status) {
      return status in ['LEAD', 'PROSPECT', 'CLIENT', 'LOST'];
    }

    function hasNoObsoleteBusinessFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['owner_id', 'onboarding_completed', 'created_at', 'updated_at']);
    }

    function hasNoObsoleteFields(data) {
      return data == null || !data.keys().hasAny([
        'business_id', 'branch_id', 'department_id', 'employee_id', 'firebase_uid', 
        'display_name', 'employee_name', 'created_at', 'updated_at', 'hire_date', 
        'base_salary', 'salary_base_htg', 'salaryBaseHtg', 'payment_model', 'commission_rate', 
        'business_status', 'account_status', 'onboarding_completed', 'normalized_email', 
        'total_gross_htg', 'total_net_htg', 'amount_paid', 'is_paid', 'customer_id', 
        'invoice_date', 'due_date', 'owner_id', 'is_active', 'totalGrossHtg', 'totalNetHtg',
        'target_user_id', 'target_roles', 'read_at', 'amount_cents', 'debit_account',
        'credit_account', 'debit_cents', 'credit_cents'
      ]);
    }

    function userHasBusiness(uid) {
      return (
        (exists(/databases/$(database)/documents/users/$(uid)) && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('businessId', '') != '' && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('businessId', '') != null) ||
        (exists(/databases/$(database)/documents/users/$(uid)) && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('business_id', '') != '' && 
         get(/databases/$(database)/documents/users/$(uid)).data.get('business_id', '') != null) ||
        exists(/databases/$(database)/documents/businesses/$('biz_' + uid))
      );
    }

    function hasNoObsoleteBranchFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['business_id', 'is_active', 'created_at', 'updated_at']);
    }

    function hasNoObsoleteDepartmentFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['business_id', 'branch_id', 'is_active', 'created_at', 'updated_at']);
    }

    function hasNoObsoleteCostCenterFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['business_id', 'branch_id', 'department_id', 'created_at', 'updated_at']);
    }

    function hasNoObsoleteEmployeeFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['salary_base_htg', 'salaryBaseHtg', 'business_id', 'branch_id', 'department_id', 'is_active', 'created_at', 'updated_at']);
    }

    function hasNoObsoleteInvoiceFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['totalGrossHtg']);
    }

    function hasNoObsoletePayrollCycleFields(data) {
      return hasNoObsoleteFields(data) && !data.keys().hasAny(['totalGrossHtg', 'totalNetHtg']);
    }

    function hasNoObsoleteUserFields(data) {
      return data == null || !data.keys().hasAny([
        'salary_base_htg', 'salaryBaseHtg', 'total_gross_htg', 'total_net_htg', 'amount_paid'
      ]);
    }

    // === LOGGING & AUDIT TRAIL (Immutable Forensic Records) ===
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create: if isAuthenticated(); 
      allow update: if false; // Audit logs must be strictly immutable
      allow delete: if false; // Forensic anti-tampering rule
    }

    match /forensic_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create: if isAuthenticated(); 
      allow update: if false; 
      allow delete: if false;
    }

    match /enterprise_audit_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create: if isAuthenticated(); 
      allow update: if false; 
      allow delete: if false;
    }

    match /security_audit_logs/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create: if isAuthenticated(); 
      allow update: if false; 
      allow delete: if false;
    }

    match /ai_cfo_audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (getBusinessId(resource.data) == 'none' || isTenantScoped(getBusinessId(resource.data))));
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    match /attendance_justifications/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === USER PROFILES ===
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin()) && hasNoObsoleteUserFields(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data))) && hasNoObsoleteUserFields(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // === USER PREFERENCES ===
    match /user_preferences/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin()) && hasNoObsoleteFields(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // === PENDING BUSINESS APPLICATIONS (Onboarding Super Admin Workflow) ===
    match /pending_businesses/{id} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        resource == null ||
        id == ('pbiz_' + request.auth.uid) ||
        resource.data.get('ownerUid', '') == request.auth.uid ||
        resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.get('ownerUid', '') == request.auth.uid ||
        request.resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('owner_uid', '') == request.auth.uid) &&
          request.resource.data.get('status', 'PENDING') == 'PENDING'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS TENANTS ===
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || businessId == getUserBusinessId() || isBusinessOwner(businessId));
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          !userHasBusiness(request.auth.uid) &&
          request.resource.data.get('ownerId', '') == request.auth.uid
        )
      ) && hasNoObsoleteBusinessFields(request.resource.data) && hasNoObsoleteFields(request.resource.data);
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.get('ownerId', '') == request.auth.uid ||
        resource.data.get('owner_id', '') == request.auth.uid ||
        isBusinessOwner(businessId) ||
        (businessId == getUserBusinessId() && getUserRole() in ['ADMIN', 'OWNER'])
      ) && hasNoObsoleteBusinessFields(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // === EVENT PROCESSING IDEMPOTENCY REGISTRY ===
    match /businesses/{businessId}/event_processing/{consumerId} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/{document=**} {
      allow read, write: if isTenantScoped(businessId);
    }

    // === BUSINESS SETTINGS ===
    match /business_settings/{businessId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantAdminOrManager(businessId);
      allow delete: if isSuperAdmin();
    }

    // === BRANCHES ===
    match /branches/{branchId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(request.resource.data)) && hasNoObsoleteBranchFields(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(resource.data)) && hasNoObsoleteBranchFields(request.resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === DEPARTMENTS ===
    match /departments/{deptId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(request.resource.data)) && hasNoObsoleteDepartmentFields(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(resource.data)) && hasNoObsoleteDepartmentFields(request.resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === BUSINESS UNITS ===
    match /business_units/{unitId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === COST CENTERS ===
    match /cost_centers/{costCenterId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(request.resource.data)) && hasNoObsoleteCostCenterFields(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(resource.data)) && hasNoObsoleteCostCenterFields(request.resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ORGANIZATIONS ===
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ROLES ===
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === EMPLOYEES ===
    match /employees/{empId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(request.resource.data)) && hasNoObsoleteEmployeeFields(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || (isTenantAdminOrManager(getBusinessId(resource.data)) && hasNoObsoleteEmployeeFields(request.resource.data)));
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data))
      );
    }

    // === INVITATIONS ===
    match /invitations/{inviteId} {
      allow read: if true; // Needed to validate token before signup
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(resource.data)) ||
        (
          resource.data.get('email', '').lower() == getAuthEmail().lower() ||
          resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower() ||
          request.resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === EXCHANGE RATES ===
    match /exchange_rates/{rateId} {
      allow read: if true; // Public currency reference
      allow write: if isAuthenticated() && (isSuperAdmin() || getUserRole() in ['ADMIN', 'MANAGER', 'OWNER']);
    }

    // === TRANSACTIONS & GENERAL LEDGER ===
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data))) && hasNoObsoleteFields(request.resource.data);
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data))) && hasNoObsoleteFields(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /ledger_transactions/{txId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data))) && hasNoObsoleteFields(request.resource.data);
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data))) && hasNoObsoleteFields(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /financial_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /bank_reconciliations/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /analytics_processed_transactions/{id} {
      allow read, write: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
    }

    // === GL (Bulk Upload Storage) ===
    match /GL/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === EVENTS (Reliable Outbox & Orchestrator Events) ===
    match /events/{eventId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    // === WORKFLOW & APPROVAL ENGINE ===
    match /workflow_definitions/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /approval_policies/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /approval_instances/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /workflow_instances/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === INTEGRITY REPORTS ===
    match /integrity_reports/{reportId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === ANALYTICS SNAPSHOTS ===
    match /analytics_snapshots/{snapId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === BRANCH DEPARTMENT LINKS ===
    match /branch_department_links/{linkId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === EMPLOYEE CONTRACTS ===
    match /employee_contracts/{contractId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === SHIFTS & SCHEDULES ===
    match /shifts/{shiftId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if false; // Physical deletion forbidden; soft-delete required
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /shift_templates/{templateId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /schedule_templates/{templateId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /employee_assignments/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /shift_change_requests/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === EMPLOYEE BADGES ===
    match /employee_badges/{badgeId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === ATTENDANCE RECORDS & LOGS ===
    match /attendance_adjustment_requests/{requestId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
