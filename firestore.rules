      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === SUBSCRIPTIONS & FEATURES ===
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subscriptions/{businessId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(businessId) || businessId == 'biz_' + request.auth.uid || businessId == getUserBusinessId());
      allow write: if isSuperAdmin();
    }

    match /features/{businessId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(businessId) || businessId == 'biz_' + request.auth.uid || businessId == getUserBusinessId());
      allow write: if isSuperAdmin();
    }

    // === SALARY STRUCTURES & PAYROLL PROFILES ===
    match /salary_structures/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payroll_profiles/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === PAYROLL INPUTS & SNAPSHOTS ===
    match /payroll_inputs_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payroll_input_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payroll_deductions/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payroll_bonuses/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /salary_advances/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /attendance_rules/{businessId} {
      allow read: if isTenantScoped(businessId);
      allow write: if isTenantAdminOrManager(businessId);
    }

    // === ONBOARDING REQUESTS ===
    match /onboarding_requests/{reqId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    // === ENTERPRISE HEALTH SNAPSHOTS ===
    match /enterprise_health_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    // === FIRESTORE HEALTH HEARTBEAT ===
    match /_health_heartbeat_/{id} {
      allow read, write: if isAuthenticated();
    }

    // === ORCHESTRATION QUEUE & EVENT OUTBOX ===
    match /orchestration_queue/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    match /event_outbox/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    // === ENTERPRISE INCIDENTS & DEAD LETTERS ===
    match /enterprise_incidents/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /workflow_dead_letters/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    // === GLOBAL BUSINESS SNAPSHOTS & MEMBERSHIPS ===
    match /memberships/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /business_snapshots/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (id == getUserBusinessId() || isTenantScoped(id) || (resource != null && isTenantScoped(getBusinessId(resource.data)))));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        id == getUserBusinessId() ||
        isTenantScoped(id)
      );
      allow delete: if isSuperAdmin();
    }

    // === ENTERPRISE DOCUMENT MANAGEMENT SYSTEM (EDMS) ===
    match /documents/{docId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if false; // Physical deletion forbidden; soft-archive via status="ARCHIVED" required
    }

    // === WORKFORCE PERFORMANCE & COMMISSION ENGINE ===
    match /employee_department_history/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /employee_departments/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /employee_department_activity/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /commission_plans/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /employee_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /department_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /branch_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /business_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /employee_attendance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === SYSTEM CONFIGURATION & SUPERADMIN RESOURCES ===
    match /system_config/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /security_alerts/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin();
    }

    match /business_archives/{id} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // === NOTIFICATIONS ===
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data)) ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.get('target_user_id', '') == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(request.resource.data))
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantAdminOrManager(getBusinessId(resource.data))
      );
    }

    // === ERP EVENTS ===
    match /erp_events/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
    }

    // === CRM, PROSPECTING & SALES INVOICING ===
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidLeadStatus(request.resource.data.get('status', 'LEAD'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidLeadStatus(request.resource.data.get('status', 'LEAD'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN', 'MANAGER'])
      );
    }

    match /proformas/{proformaId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidProformaStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(request.resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isTenantScoped(getBusinessId(resource.data)) &&
          isValidAmount(request.resource.data.get('totalAmount', 0)) &&
          isValidInvoiceStatus(request.resource.data.get('status', 'DRAFT'))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /invoice_templates/{templateId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTenantScoped(getBusinessId(request.resource.data)) && getUserRole() in ['SUPER_ADMIN', 'OWNER', 'ADMIN'])
      );
    }

    match /sales_requests/{reqId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'name']) &&
                       request.resource.data.keys().hasOnly(['id', 'email', 'name', 'phone', 'companyName', 'message', 'createdAt', 'status']) &&
                       request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
                       request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
                       (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000));
      allow read, update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /analytics_anomalies/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /department_aliases/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /workforce_performance_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === PHASE 7: WORKFORCE INTELLIGENCE, METRICS & BENCHMARKS ===
    match /workforce_productivity_benchmarks/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /labor_economics_metrics/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /shift_labor_efficiency/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /metric_snapshots/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /financial_metrics/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    match /payment_methods/{methodId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.scope == "GLOBAL" || 
        (resource.data.scope == "TENANT" && isTenantScoped(getBusinessId(resource.data)))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (request.resource.data.scope == "TENANT" && isTenantAdminOrManager(getBusinessId(request.resource.data)))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource.data.scope == "TENANT" && isTenantAdminOrManager(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
    }

    // === CATCH-ALL FALLBACK FOR ALL COLLECTIONS & SUBCOLLECTIONS ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


