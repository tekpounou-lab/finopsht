rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Core Security & Identity Helpers ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return request.auth.token.get('email', '');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          ('is_super_admin' in request.auth.token && request.auth.token.is_super_admin == true) || 
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN')
        )) ||
        (
          'email' in request.auth.token &&
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.email.lower() in ['tekpounou@gmail.com', 'admin@finops.com', 'superadmin@finops.com']
        )
      );
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getMyProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserBusinessId() {
      return request.auth.token.get('businessId', request.auth.token.get('business_id', 'none'));
    }

    function getUserRole() {
      return request.auth.token.get('role', 'none');
    }

    function getBusinessId(data) {
      return data.get('businessId', data.get('business_id', data.get('tenantId', data.get('tenant_id', 'none'))));
    }

    function getActorTenantId() {
      return request.auth.token.get('businessId', '') != ''
        ? request.auth.token.get('businessId', '')
        : (request.auth.token.get('business_id', '') != ''
          ? request.auth.token.get('business_id', '')
          : (hasUserData()
            ? (getMyProfile().get('businessId', '') != ''
              ? getMyProfile().get('businessId', '')
              : (getMyProfile().get('business_id', '') != ''
                ? getMyProfile().get('business_id', '')
                : (getMyProfile().get('tenantId', '') != ''
                  ? getMyProfile().get('tenantId', '')
                  : getMyProfile().get('tenant_id', ''))))
            : ''));
    }

    function isPathPrefixedWithActorTenant(docId, prefix) {
      return getActorTenantId() != '' &&
        docId.size() > (prefix.size() + getActorTenantId().size() + 1) &&
        docId[0:prefix.size()] == prefix &&
        docId[prefix.size():prefix.size() + getActorTenantId().size() + 1] == (getActorTenantId() + '_');
    }

    function isOwnTenantDailyRateGridId(gridId) {
      return isPathPrefixedWithActorTenant(gridId, 'fx_grid_') &&
        gridId[8 + getActorTenantId().size() + 1 : gridId.size()].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        isTenantScoped(getActorTenantId());
    }

    function isBusinessOwner(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner'])
              )
            ) ||
            (exists(/databases/$(database)/documents/businesses/$(bizId)) && (
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_id', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerUid', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_uid', '') == request.auth.uid
            ))
          )
        )
      );
    }

    function canValidateOrSealPayroll(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'owner_admin'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner', 'admin', 'owner_admin'])
              )
            )
          )
        )
      );
    }

    function isTenantScoped(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            request.auth.token.get('businessId', '') == bizId ||
            request.auth.token.get('business_id', '') == bizId ||
            (hasUserData() && (
              getMyProfile().get('businessId', '') == bizId ||
              getMyProfile().get('business_id', '') == bizId ||
              getMyProfile().get('tenantId', '') == bizId ||
              getMyProfile().get('tenant_id', '') == bizId
            ))
          )
        )
      );
    }

    function isTenantAdminOrManager(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'manager', 'owner_admin'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner', 'admin', 'manager', 'owner_admin'])
              )
            )
          )
        )
      );
    }

    function isTenantCashOperator(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'manager', 'head_teller', 'senior_teller', 'junior_teller', 'teller', 'owner_admin', 'master_head_teller'] ||
                (hasUserData() && (
                  getMyProfile().get('role', '').lower() in ['owner', 'admin', 'manager', 'head_teller', 'senior_teller', 'junior_teller', 'teller', 'owner_admin', 'master_head_teller']
                ))
              )
            )
          )
        )
      );
    }

    function isMasterHeadTeller(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            request.auth.token.get('businessId', '') == bizId ||
            request.auth.token.get('business_id', '') == bizId ||
            (hasUserData() && (
              getMyProfile().get('businessId', '') == bizId ||
              getMyProfile().get('business_id', '') == bizId
            ))
          ) && (
            request.auth.token.get('role', '').lower() == 'master_head_teller' ||
            (hasUserData() && getMyProfile().get('role', '').lower() == 'master_head_teller')
          )
        )
      );
    }

    function isTenantFinanceOrManager(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'manager', 'owner_admin', 'accountant', 'hr_payroll'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner', 'admin', 'manager', 'owner_admin', 'accountant', 'hr_payroll'])
              )
            )
          )
        )
      );
    }

    function isNonAuditorTenantMember(bizId) {
      return isAuthenticated() &&
        isTenantScoped(bizId) &&
        request.auth.token.get('role', '').upper() != 'AUDITOR' &&
        (!hasUserData() || getMyProfile().get('role', '').upper() != 'AUDITOR');
    }

    function isBranchScopedCashRoleLower() {
      return (
        request.auth.token.get('role', '').lower() in ['head_teller', 'senior_teller', 'junior_teller', 'teller'] ||
        (hasUserData() && getMyProfile().get('role', '').lower() in ['head_teller', 'senior_teller', 'junior_teller', 'teller'])
      );
    }

    function getDocBranchId(data) {
      return data.get('branch_id', data.get('branchId', ''));
    }

    function getActorBranchId() {
      return request.auth.token.get('branch_id', '') != ''
        ? request.auth.token.get('branch_id', '')
        : (request.auth.token.get('branchId', '') != ''
          ? request.auth.token.get('branchId', '')
          : (hasUserData() ? getMyProfile().get('branch_id', getMyProfile().get('branchId', '')) : ''));
    }

    function isBranchScopedCashAuthorized(data) {
      return isSuperAdmin() ||
        isTenantAdminOrManager(getBusinessId(data)) ||
        isMasterHeadTeller(getBusinessId(data)) ||
        (
          isTenantCashOperator(getBusinessId(data)) &&
          (!isBranchScopedCashRoleLower() || (
            getActorBranchId() != '' &&
            getDocBranchId(data) != '' &&
            getActorBranchId() == getDocBranchId(data)
          ))
        );
    }

    function isValidAmount(val) {
      return val is number && val >= 0;
    }

    function isValidLeadStatus(status) {
      return status is string && status in ['LEAD', 'PROSPECT', 'CLIENT', 'LOST'];
    }

    function isValidProformaStatus(status) {
      return status is string && status in ['DRAFT', 'SENT', 'ACCEPTED', 'EXPIRED', 'CONVERTED_TO_INVOICE', 'REJECTED'];
    }

    function isValidInvoiceStatus(status) {
      return status is string && status in ['DRAFT', 'SENT', 'ISSUED', 'PAID', 'PARTIALLY_PAID', 'OVERDUE', 'CANCELLED'];
    }

    function hasNoProfileConflict(data) {
      return !('operational_profile' in data && 'operationalProfile' in data) ||
        (data.operational_profile == null && data.operationalProfile == null) ||
        (data.operational_profile is string && data.operationalProfile is string && data.operational_profile.lower() == data.operationalProfile.lower());
    }

    function resolvedProfileLower(data) {
      return ('operational_profile' in data && data.operational_profile != null)
        ? (data.operational_profile is string ? data.operational_profile.lower() : '__invalid__')
        : (('operationalProfile' in data && data.operationalProfile != null)
          ? (data.operationalProfile is string ? data.operationalProfile.lower() : '__invalid__')
          : '');
    }

    function isValidRoleProfileCompatibility(data) {
      return !('role' in data) || (
        data.role is string &&
        hasNoProfileConflict(data) &&
        (
          (data.role.upper() == 'EMPLOYEE' && resolvedProfileLower(data) in ['vendeur', 'polyvalent']) ||
          (data.role.upper() in ['JUNIOR_TELLER', 'SENIOR_TELLER', 'HEAD_TELLER', 'MASTER_HEAD_TELLER', 'TELLER'] && resolvedProfileLower(data) == 'teller') ||
          (!(data.role.upper() in ['EMPLOYEE', 'JUNIOR_TELLER', 'SENIOR_TELLER', 'HEAD_TELLER', 'MASTER_HEAD_TELLER', 'TELLER']) && resolvedProfileLower(data) == '')
        )
      );
    }

    function canCreateAuditLog(data) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getBusinessId(data) == 'global' ||
        (getBusinessId(data) != 'none' && isTenantScoped(getBusinessId(data)))
      );
    }

// === LOGGING & AUDIT TRAIL (Immutable Forensic Records) ===
    match /audit_logs/{logId} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false; // Forensic anti-tampering rule
    }

    match /forensic_logs/{id} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /enterprise_audit_logs/{id} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /security_audit_logs/{id} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /ai_cfo_audit_logs/{logId} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if canCreateAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /attendance_justifications/{id} {
      allow get: if isAuthenticated() && (isSuperAdmin() || (resource != null && isTenantScoped(getBusinessId(resource.data))));
      allow list: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === USER PROFILES ===
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && getBusinessId(resource.data) != 'none' && isTenantScoped(getBusinessId(resource.data)))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !('is_super_admin' in request.resource.data && request.resource.data.is_super_admin == true) &&
          !('isSuperAdmin' in request.resource.data && request.resource.data.isSuperAdmin == true) &&
          !('super_admin' in request.resource.data && request.resource.data.super_admin == true) &&
          !('is_owner' in request.resource.data && request.resource.data.is_owner == true) &&
          !('isOwner' in request.resource.data && request.resource.data.isOwner == true) &&
          !('permissions' in request.resource.data) &&
          !('operational_profile' in request.resource.data) &&
          !('operationalProfile' in request.resource.data) &&
          (!('role' in request.resource.data) || request.resource.data.role.upper() in ['EMPLOYEE', '']) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == '') &&
          (!('business_id' in request.resource.data) || request.resource.data.business_id == '') &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == '') &&
          (!('tenant_id' in request.resource.data) || request.resource.data.tenant_id == '')
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'display_name', 'displayName', 'name',
            'phone_number', 'phoneNumber', 'phone',
            'address',
            'photo_url', 'photoURL', 'avatarUrl', 'avatar_url',
            'preferred_language', 'preferredLanguage', 'language', 'locale',
            'timezone',
            'email_notifications_enabled', 'emailNotificationsEnabled',
            'push_notifications_enabled', 'pushNotificationsEnabled',
            'notification_preferences', 'notificationPreferences',
            'theme', 'ui_preferences', 'uiPreferences',
            'bio', 'job_title', 'jobTitle', 'department',
            'auth_provider', 'authProvider', 'auth_providers', 'authProviders',
            'has_password', 'has_set_password', 'hasSetPassword',
            'requested_role', 'requestedRole',
            'company_code', 'companyCode',
            'onboarding_completed', 'onboardingComplete',
            'account_status', 'accountStatus',
            'updated_at', 'updatedAt', 'last_active_at', 'lastActiveAt'
          ]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['account_status', 'accountStatus']) ||
            (
              request.resource.data.get('account_status', '').upper() in ['NEW_USER', 'PENDING_MEMBER', 'PENDING_OWNER', 'WAITING_APPROVAL'] &&
              request.resource.data.get('accountStatus', '').upper() in ['NEW_USER', 'PENDING_MEMBER', 'PENDING_OWNER', 'WAITING_APPROVAL']
            )
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requested_role', 'requestedRole']) ||
            (
              request.resource.data.get('requested_role', '').upper() != 'SUPER_ADMIN' &&
              request.resource.data.get('requestedRole', '').upper() != 'SUPER_ADMIN'
            )
          )
        ) ||
        (
          request.auth.uid != userId &&
          resource != null && getBusinessId(resource.data) != 'none' && isTenantAdminOrManager(getBusinessId(resource.data)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_super_admin', 'isSuperAdmin', 'super_admin']) &&
          (!('role' in request.resource.data) || request.resource.data.role != 'SUPER_ADMIN') &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == getBusinessId(resource.data)) &&
          (!('business_id' in request.resource.data) || request.resource.data.business_id == getBusinessId(resource.data)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'operational_profile', 'operationalProfile']) || isValidRoleProfileCompatibility(request.resource.data))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === USER PREFERENCES ===
    match /user_preferences/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // === PENDING BUSINESS APPLICATIONS (Onboarding Super Admin Workflow) ===
    match /pending_businesses/{id} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        id == ('pbiz_' + request.auth.uid) ||
        (resource != null && (
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && (
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_uid', '') == request.auth.uid ||
          resource.data.get('ownerId', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.get('ownerUid', '') == request.auth.uid ||
        request.resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('owner_uid', '') == request.auth.uid) &&
          request.resource.data.get('status', 'PENDING') == 'PENDING'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS TENANTS ===
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isTenantScoped(businessId) ||
        (resource != null && (
          resource.data.get('ownerId', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid ||
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_uid', '') == request.auth.uid
        ))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.get('ownerId', '') == request.auth.uid ||
          request.resource.data.get('owner_id', '') == request.auth.uid
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (
            isBusinessOwner(businessId) ||
            isTenantAdminOrManager(businessId) ||
            resource.data.get('ownerId', '') == request.auth.uid ||
            resource.data.get('owner_id', '') == request.auth.uid
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId', 'owner_id', 'ownerUid', 'owner_uid',
            'subscriptionPlan', 'subscription_plan', 'plan', 'tier',
            'isApproved', 'status'
          ])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS SUBCOLLECTIONS ===
    match /businesses/{businessId}/event_processing/{consumerId} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/event_outbox/{id} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/configuration/{id} {
      allow read: if isTenantScoped(businessId);
      allow write: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/metric_snapshots/{id} {
      allow read: if isTenantScoped(businessId);
      allow write: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/documents/{docId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId);
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/leads/{leadId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId);
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/proformas/{proformaId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId) && isValidAmount(request.resource.data.get('totalAmount', 0));
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/invoices/{invoiceId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId) && isValidAmount(request.resource.data.get('totalAmount', 0));
      allow delete: if isTenantAdminOrManager(businessId);
    }

    // === BUSINESS SETTINGS & ENTITLEMENTS (R-01 REMEDIATION) ===
    // Global features and module entitlements are reserved strictly for platform SUPER_ADMIN.
    // Tenant users (including OWNER and MANAGER) cannot create, update, or delete features.
    match /businesses/{businessId}/settings/features {
      allow read: if isTenantScoped(businessId);
      allow write: if isSuperAdmin();
    }

    // General tenant settings (e.g. appearance, preferences, working hours, payroll policies)
    // Tenant admin/manager can write other settings, but NOT features, entitlements, or subscription docs.
    match /businesses/{businessId}/settings/{settingId} {
      allow read: if isTenantScoped(businessId);
      allow write: if isSuperAdmin() || (
        isTenantAdminOrManager(businessId) && 
        settingId != 'features' && 
        settingId != 'feature' && 
