rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Core Security & Identity Helpers ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return request.auth.token.get('email', '');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          ('is_super_admin' in request.auth.token && request.auth.token.is_super_admin == true) || 
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN')
        )) ||
        (
          'email' in request.auth.token &&
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.email.lower() in ['tekpounou@gmail.com', 'admin@finops.com', 'superadmin@finops.com']
        )
      );
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getMyProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserBusinessId() {
      return request.auth.token.get('businessId', request.auth.token.get('business_id', 'none'));
    }

    function getUserRole() {
      return request.auth.token.get('role', 'none');
    }

    function getBusinessId(data) {
      return data.get('businessId', data.get('business_id', data.get('tenantId', data.get('tenant_id', 'none'))));
    }

    function isBusinessOwner(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner'])
              )
            ) ||
            (exists(/databases/$(database)/documents/businesses/$(bizId)) && (
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_id', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('ownerUid', '') == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(bizId)).data.get('owner_uid', '') == request.auth.uid
            ))
          )
        )
      );
    }

    function canValidateOrSealPayroll(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'owner_admin'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner', 'admin', 'owner_admin'])
              )
            )
          )
        )
      );
    }

    function isTenantScoped(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            request.auth.token.get('businessId', '') == bizId ||
            request.auth.token.get('business_id', '') == bizId ||
            (hasUserData() && (
              getMyProfile().get('businessId', '') == bizId ||
              getMyProfile().get('business_id', '') == bizId ||
              getMyProfile().get('tenantId', '') == bizId ||
              getMyProfile().get('tenant_id', '') == bizId
            ))
          )
        )
      );
    }

    function isTenantAdminOrManager(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in ['owner', 'admin', 'manager', 'head_teller', 'owner_admin'] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in ['owner', 'admin', 'manager', 'head_teller', 'owner_admin'])
              )
            )
          )
        )
      );
    }

    function isTenantCashOperator(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          bizId != 'none' && bizId != '' && bizId != null && (
            isBusinessOwner(bizId) ||
            (
              (
                request.auth.token.get('businessId', '') == bizId ||
                request.auth.token.get('business_id', '') == bizId ||
                (hasUserData() && (
                  getMyProfile().get('businessId', '') == bizId ||
                  getMyProfile().get('business_id', '') == bizId
                ))
              ) &&
              (
                request.auth.token.get('role', '').lower() in [
                  'owner', 'admin', 'manager', 'head_teller', 'senior_teller', 'junior_teller', 'teller', 'owner_admin'
                ] ||
                (hasUserData() && getMyProfile().get('role', '').lower() in [
                  'owner', 'admin', 'manager', 'head_teller', 'senior_teller', 'junior_teller', 'teller', 'owner_admin'
                ])
              )
            )
          )
        )
      );
    }

    function canCreateAuditLog(data) {
      return isAuthenticated();
    }

// === LOGGING & AUDIT TRAIL (Immutable Forensic Records) ===
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false; // Forensic anti-tampering rule
    }

    match /forensic_logs/{id} {
      allow read: if isAuthenticated();
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /enterprise_audit_logs/{id} {
      allow read: if isAuthenticated();
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /security_audit_logs/{id} {
      allow read: if isAuthenticated();
      allow create: if canCreateAuditLog(request.resource.data); 
      allow update, delete: if false;
    }

    match /ai_cfo_audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if canCreateAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /attendance_justifications/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)));
      allow delete: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === USER PROFILES ===
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !('is_super_admin' in request.resource.data && request.resource.data.is_super_admin == true) &&
          !('isSuperAdmin' in request.resource.data && request.resource.data.isSuperAdmin == true) &&
          !('super_admin' in request.resource.data && request.resource.data.super_admin == true) &&
          !('is_owner' in request.resource.data && request.resource.data.is_owner == true) &&
          !('isOwner' in request.resource.data && request.resource.data.isOwner == true) &&
          !('permissions' in request.resource.data) &&
          (!('role' in request.resource.data) || request.resource.data.role.upper() in ['EMPLOYEE', '']) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == '') &&
          (!('business_id' in request.resource.data) || request.resource.data.business_id == '') &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == '') &&
          (!('tenant_id' in request.resource.data) || request.resource.data.tenant_id == '')
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'is_super_admin', 'isSuperAdmin', 'super_admin', 'permissions', 'is_owner', 'isOwner'
          ]) &&
          (!('role' in request.resource.data) || request.resource.data.role.upper() != 'SUPER_ADMIN')
        ) ||
        (
          request.auth.uid != userId &&
          resource != null && getBusinessId(resource.data) != 'none' && isTenantAdminOrManager(getBusinessId(resource.data)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_super_admin', 'isSuperAdmin']) &&
          (!('role' in request.resource.data) || request.resource.data.role != 'SUPER_ADMIN') &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == getBusinessId(resource.data)) &&
          (!('business_id' in request.resource.data) || request.resource.data.business_id == getBusinessId(resource.data))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === USER PREFERENCES ===
    match /user_preferences/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // === PENDING BUSINESS APPLICATIONS (Onboarding Super Admin Workflow) ===
    match /pending_businesses/{id} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        id == ('pbiz_' + request.auth.uid) ||
        (resource != null && (
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && (
          resource.data.get('ownerUid', '') == request.auth.uid ||
          resource.data.get('owner_uid', '') == request.auth.uid ||
          resource.data.get('ownerId', '') == request.auth.uid ||
          resource.data.get('owner_id', '') == request.auth.uid
        ))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.get('ownerUid', '') == request.auth.uid ||
        request.resource.data.get('owner_uid', '') == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('owner_uid', '') == request.auth.uid) &&
          request.resource.data.get('status', 'PENDING') == 'PENDING'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS TENANTS ===
    match /businesses/{businessId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.get('ownerId', '') == request.auth.uid ||
          request.resource.data.get('owner_id', '') == request.auth.uid
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (
            isBusinessOwner(businessId) ||
            isTenantAdminOrManager(businessId) ||
            resource.data.get('ownerId', '') == request.auth.uid ||
            resource.data.get('owner_id', '') == request.auth.uid
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId', 'owner_id', 'ownerUid', 'owner_uid',
            'subscriptionPlan', 'subscription_plan', 'plan', 'tier',
            'isApproved', 'status'
          ])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // === BUSINESS SUBCOLLECTIONS ===
    match /businesses/{businessId}/event_processing/{consumerId} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/event_outbox/{id} {
      allow read, write: if isTenantScoped(businessId);
    }

    match /businesses/{businessId}/configuration/{id} {
      allow read: if isTenantScoped(businessId);
      allow write: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/metric_snapshots/{id} {
      allow read: if isTenantScoped(businessId);
      allow write: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/documents/{docId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId);
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/leads/{leadId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId);
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/proformas/{proformaId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId) && isValidAmount(request.resource.data.get('totalAmount', 0));
      allow delete: if isTenantAdminOrManager(businessId);
    }

    match /businesses/{businessId}/invoices/{invoiceId} {
      allow read: if isTenantScoped(businessId);
      allow create, update: if isTenantScoped(businessId) && isValidAmount(request.resource.data.get('totalAmount', 0));
      allow delete: if isTenantAdminOrManager(businessId);
    }

    // === BUSINESS SETTINGS & ENTITLEMENTS (R-01 REMEDIATION) ===
    // Global features and module entitlements are reserved strictly for platform SUPER_ADMIN.
    // Tenant users (including OWNER and MANAGER) cannot create, update, or delete features.
    match /businesses/{businessId}/settings/features {
      allow read: if isTenantScoped(businessId);
      allow write: if isSuperAdmin();
    }

    // General tenant settings (e.g. appearance, preferences, working hours, payroll policies)
    // Tenant admin/manager can write other settings, but NOT features, entitlements, or subscription docs.
    match /businesses/{businessId}/settings/{settingId} {
      allow read: if isTenantScoped(businessId);
      allow write: if isSuperAdmin() || (
        isTenantAdminOrManager(businessId) && 
        settingId != 'features' && 
        settingId != 'feature' && 
        settingId != 'entitlements' && 
        settingId != 'modules' && 
        settingId != 'activeModules' && 
        settingId != 'enabledModules' && 
        settingId != 'subscription' && 
        settingId != 'subscriptionPlan' && 
        settingId != 'plan' && 
        settingId != 'tier' && 
        !request.resource.data.keys().hasAny([
          'features', 'feature', 'entitlements', 'modules', 
          'activeModules', 'enabledModules', 'subscription', 
          'subscriptionPlan', 'plan', 'tier'
        ])
      );
    }

    match /businesses/{businessId}/{subcollection}/{document=**} {
      allow read: if isTenantScoped(businessId);
      allow write: if subcollection != 'settings' && 
                      subcollection != 'features' && 
                      subcollection != 'subscriptions' && 
                      subcollection != 'entitlements' && 
                      isTenantAdminOrManager(businessId);
    }

    // === BUSINESS SETTINGS ===
    match /business_settings/{businessId} {
      allow read: if isTenantScoped(businessId);
      allow create: if isSuperAdmin() || (
        isTenantAdminOrManager(businessId) && 
        !request.resource.data.keys().hasAny(['features', 'subscription', 'plan', 'tier', 'entitlements'])
      );
      allow update: if isSuperAdmin() || (
        isTenantAdminOrManager(businessId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['features', 'subscription', 'plan', 'tier', 'entitlements'])
      );
      allow delete: if isSuperAdmin();
    }

    // === BRANCHES ===
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === DEPARTMENTS ===
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === BUSINESS UNITS ===
    match /business_units/{unitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === COST CENTERS ===
    match /cost_centers/{costCenterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)) || isTenantAdminOrManager(getBusinessId(resource.data)));
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ORGANIZATIONS ===
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(request.resource.data)) || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    // === ROLES ===
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && isTenantAdminOrManager(getBusinessId(request.resource.data)));
    }

    // === EMPLOYEES ===
    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(request.resource.data)) ||
        request.resource.data.get('firebase_uid', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid ||
        (getAuthEmail() != '' && (request.resource.data.get('email', '').lower() == getAuthEmail().lower() || request.resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower()))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(resource.data)) ||
        (
          resource.data.get('firebase_uid', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          (getAuthEmail() != '' && resource.data.get('email', '').lower() == getAuthEmail().lower()) ||
          (getAuthEmail() != '' && resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower())
        )
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && isTenantAdminOrManager(getBusinessId(resource.data))
      );
    }

    // === INVITATIONS ===
    match /invitations/{inviteId} {
      allow get, list: if isAuthenticated() && (
        isSuperAdmin() ||
        (getAuthEmail() != '' && (resource.data.get('email', '').lower() == getAuthEmail().lower() || resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower())) ||
        isTenantAdminOrManager(getBusinessId(resource.data))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(request.resource.data))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (getAuthEmail() != '' && (resource.data.get('email', '').lower() == getAuthEmail().lower() || resource.data.get('normalizedEmail', '').lower() == getAuthEmail().lower())) ||
        isTenantAdminOrManager(getBusinessId(resource.data))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(resource.data))
      );
    }

    // === EXCHANGE RATES & DAILY RATE GRIDS ===
    match /exchange_rates/{rateId} {
      allow read: if true; // Public currency reference
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(request.resource.data)) ||
        getUserRole().upper() in ['ADMIN', 'MANAGER', 'OWNER']
      );
      allow delete: if false; // Immutable financial rates
    }

    match /daily_exchange_rate_grids/{gridId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() || 
        isTenantAdminOrManager(getBusinessId(request.resource.data)) ||
        getUserRole().upper() in ['ADMIN', 'MANAGER', 'OWNER']
      );
      allow delete: if false; // Immutable financial rates grid
    }

    // === CASH MANAGEMENT & TREASURY ===
    match /cash_tills/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isTenantCashOperator(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /cash_registers/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isTenantCashOperator(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /branch_safes/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isTenantAdminOrManager(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /till_sessions/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create: if isAuthenticated() && (isSuperAdmin() || isTenantCashOperator(getBusinessId(request.resource.data)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isTenantCashOperator(getBusinessId(resource.data)) && getBusinessId(request.resource.data) == getBusinessId(resource.data))
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantAdminOrManager(getBusinessId(resource.data)));
    }

    match /internal_transfers/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, delete: if false; // Forced through trusted server API /api/cash/transfers/internal/* (Server Admin SDK only)
      allow update: if false; // Denied to client SDK; getBusinessId(request.resource.data) == getBusinessId(resource.data)
    }

    match /teller_transactions/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantScoped(getBusinessId(resource.data)));
      allow create, update, delete: if false; // Immutable financial transaction records (Server Admin SDK only)
    }

    match /customer_transfers/{id} {
