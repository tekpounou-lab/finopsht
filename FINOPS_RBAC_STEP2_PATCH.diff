--- a/src/services/PermissionService.ts
+++ b/src/services/PermissionService.ts
@@ -102,6 +102,14 @@ export class PermissionService {
   static isPayrollChecker(role: string): boolean {
     const normalized = this.normalizeRole(role);
     return normalized === "ACCOUNTANT" || normalized === "MANAGER" || normalized === "OWNER";
   }

+  static canValidateOrSealPayroll(role: string, action: "approve" | "seal" | "calculate"): boolean {
+    const normalized = this.normalizeRole(role);
+    if (action === "calculate") {
+      return normalized === "MANAGER" || normalized === "OWNER";
+    }
+    return this.isPayrollChecker(normalized);
+  }

   // Permission Table Update for ACCOUNTANT
   "ACCOUNTANT": {
     "payroll.approve": true,
     "payroll.lock": true,
     "payroll.calculate": false,
     "manage_payroll": false,
   }

