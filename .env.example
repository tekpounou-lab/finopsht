# --- Server-Side Secret Variables (Vercel Environment Variables - Serverless Only) ---
GEMINI_API_KEY=
CSRF_SECRET=
SESSION_SECRET=
LOG_LEVEL=info

# --- Firebase Admin SDK Credentials (Optional on Cloud / Vercel if using ADC or Service Account JSON) ---
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# --- Client-Side Environment Variables (Exposed to Browser with VITE_ prefix) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GA_MEASUREMENT_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_LOG_LEVEL=info
VITE_MOCK_LOG_LEVEL=warn
VITE_SESSION_ROTATION_INTERVAL_MINUTES=30
VITE_SUPER_ADMIN_EMAIL=
VITE_ENABLE_MOCKS=false
VITE_ENABLE_MOCK_LOGS=false

# --- Email Notification Service (Resend / SendGrid / Custom SMTP API) ---
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_SERVICE_PROVIDER=
